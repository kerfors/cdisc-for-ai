        "MappingRelationEnum": {
            "description": "",
            "enum": [
                "exactMatch",
                "narrowMatch",
                "broadMatch"
            ],
            "title": "MappingRelationEnum",
            "type": "string"
        },
        "OriginSourceEnum": {
            "description": "Terminology relevant to the origin source for datasets in the Define-XML document.",
            "enum": [
                "Investigator",
                "Sponsor",
                "Subject",
                "Vendor"
            ],
            "title": "OriginSourceEnum",
            "type": "string"
        },
        "OriginTypeEnum": {
            "description": "Terminology relevant to the origin type for datasets in the Define-XML document.",
            "enum": [
                "Assigned",
                "Collected",
                "Derived",
                "Predecessor",
                "Protocol"
            ],
            "title": "OriginTypeEnum",
            "type": "string"
        },
        "PackageTypeEnum": {
            "description": "",
            "enum": [
                "bc"
            ],
            "title": "PackageTypeEnum",
            "type": "string"
        },
        "PredicateTermEnum": {
            "description": "",
            "enum": [
                "ASSESSES",
                "CLASSIFIES",
                "DECODES",
                "DESCRIBES",
                "GROUPS",
                "GROUPS_BY",
                "IDENTIFIES",
