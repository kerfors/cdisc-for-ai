{
    "$defs": {
        "AssignedTerm": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "conceptId": {
                    "description": "C-code for assigned term in NCIt or left blank when CDISC terminology does not apply",
                    "pattern": "^(C[0-9]+|CNEW)$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "value": {
                    "description": "Submission value for assigned term in NCIt if it exists, or an assigned value which will be the default value",
                    "type": "string"
                }
            },
            "required": [
                "value"
            ],
            "title": "AssignedTerm",
            "type": "object"
        },
        "BiomedicalConcept": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "categories": {
                    "description": "Biomedical Concept category for the faciliation of API search and extract",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "coding": {
                    "description": "Coding for the Biomedical Concept",
                    "items": {
                        "$ref": "#/$defs/Coding"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "conceptId": {
                    "description": "A unique identifier for a Biomedical Concept which will be assigned as the NCIt code if it exists or a placeholder identifier if the concept is not yet available in NCIt",
                    "pattern": "^(C[0-9]+|NEW_[A-Z_]*[0-9]*)$",
                    "type": "string"
                },
                "dataElementConcepts": {
                    "description": "Data Element Concept",
                    "items": {
                        "$ref": "#/$defs/DataElementConcept"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "definition": {
                    "description": "NCIt definition for the Biomedical Concept; provisional defintion if concept is not available in NCIt",
                    "type": "string"
                },
                "href": {
                    "description": "URI link to NCIt for the Biomedical Concept; blank if  concept is not available in NCIt",
                    "format": "uri",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "ncitCode": {
                    "description": "NCIt C-code for the Biomedical Concept",
                    "pattern": "^(C[0-9]+)$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "packageDate": {
                    "description": "Biomedical Concept package release date indicating when the BC package was published to production",
                    "format": "date",
                    "type": "string"
                },
                "packageType": {
                    "$ref": "#/$defs/PackageTypeEnum",
                    "description": "Package type (bc for Biomedical Concepts)"
                },
                "parentConceptId": {
                    "description": "C-code for the parent concept in the NCIt hiearchy; blank if concept is not available in NCIt",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "resultScales": {
                    "description": "Scale of measurement for the Biomedical Concept result",
                    "items": {
                        "$ref": "#/$defs/BiomedicalConceptResultScaleEnum"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "shortName": {
                    "description": "NCI Preferred Name for the concept; provisional name will be used if concept is not available in NCIt",
                    "type": "string"
                },
                "synonyms": {
                    "description": "Biomedical Concept synonym equivalent to BC short name for the facilitation of API search and extraction",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "packageDate",
                "packageType",
                "conceptId",
                "categories",
                "shortName",
                "definition"
            ],
            "title": "BiomedicalConcept",
            "type": "object"
        },
        "BiomedicalConceptResultScaleEnum": {
            "description": "",
            "enum": [
                "Ordinal",
                "Narrative",
                "Nominal",
                "Quantitative",
                "Temporal"
            ],
            "title": "BiomedicalConceptResultScaleEnum",
            "type": "string"
        },
        "CodeList": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "conceptId": {
                    "description": "An identifier that uniquely represents an entity",
                    "pattern": "^(C[0-9]+|NEW_[A-Z_]*[0-9]*)$",
                    "type": "string"
                },
                "href": {
                    "description": "Link to NCIt for the Biomedical Concept",
                    "format": "uri",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "submissionValue": {
                    "description": "CDISC submission value for the codelist",
                    "pattern": "^[A-Z][A-Z0-9_]*$",
                    "type": "string"
                }
            },
            "required": [
                "conceptId",
                "submissionValue"
            ],
            "title": "CodeList",
            "type": "object"
        },
        "CodeListTerm": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "termId": {
                    "description": "C-code term in subset codelist",
                    "pattern": "^(C[0-9]+)$",
                    "type": "string"
                },
                "termValue": {
                    "description": "Submision value of term in subset codelist",
                    "type": "string"
                }
            },
            "required": [
                "termId",
                "termValue"
            ],
            "title": "CodeListTerm",
            "type": "object"
        },
        "Coding": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "code": {
                    "description": "Synonym concept for the Biomedical Concept as defined in a code system",
                    "type": "string"
                },
                "system": {
                    "description": "Identifies the code system for the synonym concept. The URL of the code system should be used if it exists",
                    "type": "string"
                },
                "systemName": {
                    "description": "Human-readable name for the code system",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "code",
                "system"
            ],
            "title": "Coding",
            "type": "object"
        },
        "ComparatorEnum": {
            "description": "",
            "enum": [
                "EQ",
                "IN"
            ],
            "title": "ComparatorEnum",
            "type": "string"
        },
        "ConceptTerm": {
            "additionalProperties": false,
            "description": "BC-side coded term: an NCIt concept with its preferred term. Used for the concept-level admissible specimen set; the SDTM submission value for the same concept lives on the recording's AssignedTerm.",
            "properties": {
                "conceptId": {
                    "description": "NCIt C-code",
                    "pattern": "^(C[0-9]+)$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "preferredTerm": {
                    "type": "string"
                }
            },
            "required": [
                "preferredTerm"
            ],
            "title": "ConceptTerm",
            "type": "object"
        },
        "DataElementConcept": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "conceptId": {
                    "description": "An identifier for a Data Element Concept (DEC) which will be assigned as the NCIt code if it exists or a placeholder identifier if the concept is not yet available in NCIt",
                    "pattern": "^(C[0-9]+|NEW_[A-Z_]*[0-9]*)$",
                    "type": "string"
                },
                "dataType": {
                    "$ref": "#/$defs/DataElementConceptDataTypeEnum",
                    "description": "Data Type for the Data Element Concept"
                },
                "exampleSet": {
                    "description": "Example values for the Data Element Concept",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "href": {
                    "description": "Link to NCIt for the Data Element Concept",
                    "format": "uri",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "ncitCode": {
                    "description": "NCI C-code for the BC Data Element Concept",
                    "pattern": "^(C[0-9]+)$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "shortName": {
                    "description": "NCI Preferred Name for the concept; provisional name will be used if concept is not available in NCIt",
                    "type": "string"
                }
            },
            "required": [
                "conceptId",
                "shortName",
                "dataType"
            ],
            "title": "DataElementConcept",
            "type": "object"
        },
        "DataElementConceptDataTypeEnum": {
            "description": "",
            "enum": [
                "boolean",
                "date",
                "datetime",
                "decimal",
                "duration",
                "float",
                "integer",
                "string",
                "uri"
            ],
            "title": "DataElementConceptDataTypeEnum",
            "type": "string"
        },
        "ExternalMapping": {
            "additionalProperties": false,
            "description": "Typed mapping to an external code system. Replaces the flat cosmos_bc:Coding for siblings: cardinality 0/1/>1 is handled by the mapping relation, not by the key (exactMatch = same observable; narrowMatch = finer external leaf, typically the unit dimension).",
            "properties": {
                "code": {
                    "type": "string"
                },
                "comment": {
                    "description": "e.g. which axis the narrowMatch refines",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "relation": {
                    "$ref": "#/$defs/MappingRelationEnum"
                },
                "system": {
                    "description": "Code system URI (e.g. https://loinc.org/, NCIt)",
                    "type": "string"
                }
            },
            "required": [
                "relation",
                "code",
                "system"
            ],
            "title": "ExternalMapping",
            "type": "object"
        },
        "InterpretationRegimeAssertion": {
            "additionalProperties": false,
            "description": "Asserts that a distinct interpretation regime applies to this sibling under a given subject state. Carries a coded pointer, NEVER the reference-range numbers (those are data, per-record/per-lab). Keyed on an existing state DEC \u2014 for glucose, Fasting Status Indicator C93566 \u2014 so fasting and post-load glucose share one sibling while carrying different regimes.",
            "properties": {
                "regime": {
                    "description": "Coded pointer to the regime (a URI or code in a regime vocabulary that does not exist yet \u2014 this is the one genuinely new governance ask).",
                    "type": "string"
                },
                "sourceAnchor": {
                    "description": "Same convention as SemanticValueSetTerm: starts \"[VERIFY]\" while the regime vocabulary does not exist.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "stateDataElementConceptId": {
                    "description": "The state DEC this regime keys on (e.g. C93566)",
                    "pattern": "^(C[0-9]+)$",
                    "type": "string"
                },
                "stateValue": {
                    "description": "Value of the state under which this regime applies (from the state DEC's value domain, e.g. Y / N; \"*\" = any state).",
                    "type": "string"
                }
            },
            "required": [
                "stateDataElementConceptId",
                "stateValue",
                "regime"
            ],
            "title": "InterpretationRegimeAssertion",
            "type": "object"
        },
