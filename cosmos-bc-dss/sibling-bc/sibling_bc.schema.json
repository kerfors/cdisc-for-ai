        "QualifiedBiomedicalConcept": {
            "additionalProperties": false,
            "description": "A sibling BC: one observation shape under a broader analyte concept. Identity is the IRI itself (read-many, citable, content-negotiated per the usdm-rdf pattern). Deliberately NOT a subclass of cosmos_bc:BiomedicalConcept \u2014 see the design decision in the file header; the analyte link is skos:broader via broaderConceptId.",
            "properties": {
                "admissibleSpecimens": {
                    "description": "Concept-level admissible specimen set (NCIt-coded)",
                    "items": {
                        "$ref": "#/$defs/ConceptTerm"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "broaderConceptId": {
                    "description": "NCIt C-code of the analyte concept (skos:broader)",
                    "pattern": "^(C[0-9]+)$",
                    "type": "string"
                },
                "definition": {
                    "description": "NCIt definition for the Biomedical Concept; provisional defintion if concept is not available in NCIt",
                    "type": "string"
                },
                "externalMappings": {
                    "items": {
                        "$ref": "#/$defs/ExternalMapping"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "interpretationRegimes": {
                    "items": {
                        "$ref": "#/$defs/InterpretationRegimeAssertion"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "iri": {
                    "format": "uri",
                    "type": "string"
                },
                "qualifierDataElementConcepts": {
                    "items": {
                        "$ref": "#/$defs/DataElementConcept"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "resultDataElementConcept": {
                    "$ref": "#/$defs/DataElementConcept",
                    "description": "The result DEC with AUTHORITATIVE dataType; recordings inherit it (SDTMVariable.dataElementConceptId -> DEC.dataType), they do not re-declare it."
                },
                "resultScale": {
                    "$ref": "#/$defs/BiomedicalConceptResultScaleEnum",
                    "description": "Single scale of measurement \u2014 the sibling split axis"
                },
                "semanticValueSet": {
                    "items": {
                        "$ref": "#/$defs/SemanticValueSetTerm"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "shortName": {
                    "description": "NCI Preferred Name for the concept; provisional name will be used if concept is not available in NCIt",
                    "type": "string"
                }
            },
            "required": [
                "iri",
                "shortName",
                "definition",
                "broaderConceptId",
                "resultScale",
                "resultDataElementConcept"
            ],
            "title": "QualifiedBiomedicalConcept",
            "type": "object"
        },
        "Recording": {
            "additionalProperties": false,
            "description": "Thinned SDTM dataset specialization: everything the sibling already states is inherited, not re-declared. Kept here: domain placement, topic/test code, the ONE specimen this recording uses (must be in the sibling's admissibleSpecimens), per-standard codelist bindings (incl. unit subset), origin, and an optional LOINC pin at recording grain. Dropped relative to cosmos_sdtm:SDTMGroup's variables: result dataType/length/ format/significantDigits (inherited via the sibling's result DEC \u2014 verified to introduce no contradiction), and the duplicated scale information.",
            "properties": {
                "domain": {
                    "description": "Domain for the SDTM specialization group",
                    "type": "string"
                },
                "loincPins": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "recordingId": {
                    "pattern": "^[A-Z][A-Z0-9_]*$",
                    "type": "string"
                },
                "resultCodelistBinding": {
                    "description": "Per-standard result binding for Coded scales",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "siblingIri": {
                    "format": "uri",
                    "type": "string"
                },
                "specimen": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/AssignedTerm"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "testCode": {
                    "type": "string"
                },
                "unitCodelistBinding": {
                    "description": "Per-standard unit binding (codelist / subset ref)",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "variableOverrides": {
                    "description": "Residual SDTM-specific variable content",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "recordingId",
                "siblingIri",
                "domain",
                "testCode"
            ],
            "title": "Recording",
            "type": "object"
        },
        "RelationShip": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "linkingPhrase": {
                    "$ref": "#/$defs/LinkingPhraseEnum",
                    "description": "Variable relationship descriptive linking phrase"
                },
                "object": {
                    "description": "Object in a variable relationship",
                    "type": "string"
                },
                "predicateTerm": {
                    "$ref": "#/$defs/PredicateTermEnum",
                    "description": "Short variable relationship linking phrase for programming purposes"
                },
                "subject": {
                    "description": "Subject in a variable relationship",
                    "type": "string"
                }
            },
            "required": [
                "subject",
                "linkingPhrase",
                "predicateTerm",
                "object"
            ],
            "title": "RelationShip",
            "type": "object"
        },
        "RoleEnum": {
            "description": "",
            "enum": [
                "Identifier",
                "Qualifier",
                "Timing",
                "Topic"
            ],
            "title": "RoleEnum",
            "type": "string"
        },
        "SDTMGroup": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "biomedicalConceptId": {
                    "description": "Biomedical Concept identifier foreign key",
                    "pattern": "^(C[0-9]+|NEW_[A-Z_]*[0-9]*)$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "datasetSpecializationId": {
                    "description": "Identifier for SDTM Value Level Metadata group",
                    "pattern": "^[A-Z][A-Z0-9_]*$",
                    "type": "string"
                },
                "domain": {
                    "description": "Domain for the SDTM specialization group",
                    "type": "string"
                },
                "packageDate": {
                    "description": "Biomedical Concept package release date indicating when the BC package was published to production",
                    "format": "date",
                    "type": "string"
                },
                "packageType": {
                    "$ref": "#/$defs/PackageTypeEnum",
                    "description": "Package type (bc for Biomedical Concepts)"
                },
                "sdtmigEndVersion": {
                    "description": "The last SDTMIG version that is applicable to the BC dataset specialization",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "sdtmigStartVersion": {
                    "description": "The earliest SDTMIG version applicable to the BC dataset specialization",
                    "type": "string"
                },
                "shortName": {
                    "description": "NCI Preferred Name for the concept; provisional name will be used if concept is not available in NCIt",
                    "type": "string"
                },
                "source": {
                    "description": "SDTM VLM Source which categorizes VLM groups by topic variable",
                    "type": "string"
                },
